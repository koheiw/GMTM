textmodel_gmm <- function(x, k = 10, model = NULL, ...,
verbose = quanteda_options("verbose")) {
gmm <- flexmix(x ~ 1, k = k,
model = FLXMCmvnorm(diagonal = TRUE),
control = list(verbose = as.integer(verbose),
minprior = 0))
list(model = gmm,
data = x,
k = k)
}
